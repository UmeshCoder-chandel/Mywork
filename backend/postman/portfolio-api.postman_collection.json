{
  "info": {
    "name": "Worker Portfolio API",
    "_postman_id": "b5d6a1c7-portfolio",
    "description": "Collection for the Worker portfolio/social API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/social" },
    { "key": "authToken", "value": "" }
  ],
  "item": [
    {
      "name": "Register (signup)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Ali Worker\",\n  \"email\": \"ali@example.com\",\n  \"phone\": \"+15551234567\",\n  \"password\": \"securepass\",\n  \"profession\": \"Plumber\"\n}" },
        "url": { "raw": "{{baseUrl}}/auth/signup", "host": [ "{{baseUrl}}" ], "path": [ "auth","signup" ] }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"ali@example.com\",\n  \"password\": \"securepass\"\n}" },
        "url": { "raw": "{{baseUrl}}/auth/login", "host": [ "{{baseUrl}}" ], "path": [ "auth","login" ] }
      }
    },
    {
      "name": "Get my profile",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
        "url": { "raw": "{{baseUrl}}/auth/me", "host": [ "{{baseUrl}}" ], "path": [ "auth","me" ] }
      }
    },
    {
      "name": "Upload avatar",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
        "body": { "mode": "formdata", "formdata": [ { "key": "avatar", "type": "file" } ] },
        "url": { "raw": "{{baseUrl}}/auth/avatar", "host": [ "{{baseUrl}}" ], "path": [ "auth","avatar" ] }
      }
    },
    {
      "name": "Create post (multipart)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "desc", "value": "Installed a new sink and fixed leak", "type": "text" },
            { "key": "category", "value": "Plumber", "type": "text" },
            { "key": "media", "type": "file" }
          ]
        },
        "url": { "raw": "{{baseUrl}}/posts", "host": [ "{{baseUrl}}" ], "path": [ "posts" ] }
      }
    },
    {
      "name": "Feed (paginated)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
        "url": { "raw": "{{baseUrl}}/posts/feed?page=1", "host": [ "{{baseUrl}}" ], "path": [ "posts","feed" ], "query": [{ "key": "page", "value": "1" }] }
      }
    },
    {
      "name": "Get post by id",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
        "url": { "raw": "{{baseUrl}}/posts/:id", "host": [ "{{baseUrl}}" ], "path": [ "posts", ":id" ] }
      }
    },
    {
      "name": "Like / Unlike post",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
        "url": { "raw": "{{baseUrl}}/posts/:id/like", "host": [ "{{baseUrl}}" ], "path": [ "posts", ":id", "like" ] }
      }
    },
    {
      "name": "Add comment",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{authToken}}" }],
        "body": { "mode": "raw", "raw": "{ \"text\": \"Great work!\" }" },
        "url": { "raw": "{{baseUrl}}/posts/:id/comments", "host": [ "{{baseUrl}}" ], "path": [ "posts", ":id", "comments" ] }
      }
    },
    {
      "name": "Search posts",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/posts/search?q=sink", "host": [ "{{baseUrl}}" ], "path": [ "posts","search" ], "query": [{ "key": "q", "value": "sink" }] }
      }
    },
    {
      "name": "Filter posts by category",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/posts/filter?category=Plumber", "host": [ "{{baseUrl}}" ], "path": [ "posts","filter" ], "query": [{ "key": "category", "value": "Plumber" }] }
      }
    }
  ]
}
